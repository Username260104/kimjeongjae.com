---
import type { CollectionEntry } from "astro:content";
import CategoryLinks from "../components/CategoryLinks.astro";
import Infobox from "../components/Infobox.astro";
import PageChrome from "../components/PageChrome.astro";
import TableOfContents from "../components/TableOfContents.astro";
import WikiShell from "./WikiShell.astro";

type WikiData = CollectionEntry<"wiki">["data"];

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

/**
 * 문서 컬렉션 항목뿐 아니라 자동 생성 페이지(예: 최근 변경)도 같은 조판을 쓰도록
 * 컬렉션 타입 대신 필요한 값만 받는다.
 */
interface ArticleData {
  title: string;
  description: string;
  lead: string;
  updated: Date;
  categories?: string[];
  infobox?: WikiData["infobox"];
  type?: WikiData["type"];
  /**
   * 검색 색인에 넣을지 여부. 문서만 true 로 둔다.
   * 목록·분류·검색처럼 자동 생성된 페이지는 무엇을 검색해도 걸리므로 제외한다.
   */
  indexed?: boolean;
}

interface Props {
  data: ArticleData;
  headings: Heading[];
}

const { data, headings } = Astro.props;
const { title, description, lead, updated, categories = [], infobox, type, indexed = true } = data;
---

<WikiShell pageTitle={title} description={description} headings={headings}>
  <article class:list={["wiki-article", { "wiki-article--main": type === "main" }]}>
    <PageChrome title={title} description={description} updated={updated} />

    <div class="article-body" data-pagefind-body={indexed ? true : undefined}>
      {infobox && (
        <div class="infobox-placement infobox-placement--desktop">
          <Infobox {...infobox} />
        </div>
      )}
      <p class="article-lead">{lead}</p>
      {infobox && (
        <div class="infobox-placement infobox-placement--mobile">
          <Infobox {...infobox} />
        </div>
      )}

      <div class="inline-toc">
        <TableOfContents headings={headings} compact />
      </div>

      <div class="article-content">
        <slot />
      </div>

      <CategoryLinks categories={categories} />
    </div>
  </article>
</WikiShell>
