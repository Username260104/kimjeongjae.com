---
import ArticleLayout from "../../layouts/ArticleLayout.astro";
import RecentChangeList from "../../components/RecentChangeList.astro";
import { getRecentChanges } from "../../lib/recent-changes";

const changes = await getRecentChanges();

/** 표시용 날짜는 시간대에 영향받지 않도록 지역 시간으로 만든다. */
const toLocalDate = (iso: string) => {
  const [year, month, day] = iso.split("-").map(Number);
  return new Date(year, month - 1, day);
};

const updated = changes.length > 0 ? toLocalDate(changes[0].date) : new Date();
---

<ArticleLayout
  data={{
    title: "최근 변경",
    description: "이 Wiki 문서의 변경 기록",
    lead: "문서가 바뀐 기록을 최신순으로 보여준다. 목록은 저장소의 변경 이력에서 자동으로 만들어지며, 문서 파일을 고친 기록만 포함한다. 화면 스타일이나 빌드 설정 변경은 세지 않는다.",
    updated,
    type: "document",
    indexed: false,
  }}
  headings={[]}
>
  <RecentChangeList changes={changes} />
</ArticleLayout>
