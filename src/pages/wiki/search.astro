---
import ArticleLayout from "../../layouts/ArticleLayout.astro";
import { getDocuments } from "../../lib/wiki";

const documents = await getDocuments();
---

<ArticleLayout
  data={{
    title: "검색",
    description: "이 Wiki의 문서를 검색합니다",
    lead: `문서 제목과 본문에서 찾는다. 지금 ${documents.length}개의 문서를 대상으로 한다.`,
    updated: new Date(),
    type: "document",
    indexed: false,
  }}
  headings={[]}
>
  <form class="search-page__form" data-search-form role="search">
    <label class="search-page__label" for="search-query">검색어</label>
    <input
      id="search-query"
      type="search"
      name="q"
      data-search-input
      placeholder="예: 김정재"
      autocomplete="off"
    />
    <button type="submit">검색</button>
  </form>

  <p class="search-page__status" data-search-status aria-live="polite"></p>
  <ul class="document-list" data-search-results></ul>
</ArticleLayout>

<script is:inline>
  (() => {
    const form = document.querySelector("[data-search-form]");
    const input = document.querySelector("[data-search-input]");
    const status = document.querySelector("[data-search-status]");
    const results = document.querySelector("[data-search-results]");
    if (!form || !input || !status || !results) return;

    let engine = null;
    let token = 0;

    const loadEngine = async () => {
      if (engine) return engine;
      // 검색 인덱스는 빌드할 때 만들어진다. 개발 서버에는 없다.
      engine = await import("/pagefind/pagefind.js");
      await engine.options({ excerptLength: 24 });
      return engine;
    };

    const clear = () => {
      results.replaceChildren();
    };

    const render = (items) => {
      clear();
      for (const item of items) {
        const li = document.createElement("li");

        const link = document.createElement("a");
        link.className = "document-list__title";
        link.href = item.url;
        link.textContent = item.meta && item.meta.title ? item.meta.title : item.url;

        const excerpt = document.createElement("p");
        excerpt.className = "document-list__summary";
        // 발췌는 우리 문서 본문에서 생성된 것이며 <mark> 강조만 포함한다.
        excerpt.innerHTML = item.excerpt;

        li.append(link, excerpt);
        results.append(li);
      }
    };

    const search = async (query) => {
      const current = ++token;
      const trimmed = query.trim();

      if (!trimmed) {
        clear();
        status.textContent = "";
        return;
      }

      status.textContent = "찾는 중…";
      let found;
      try {
        const pagefind = await loadEngine();
        const response = await pagefind.search(trimmed);
        found = await Promise.all(response.results.slice(0, 30).map((r) => r.data()));
      } catch {
        if (current !== token) return;
        clear();
        status.textContent =
          "검색 인덱스를 불러오지 못했습니다. 개발 서버에서는 검색이 동작하지 않습니다. `npm run preview` 로 확인하세요.";
        return;
      }

      if (current !== token) return;

      if (found.length === 0) {
        clear();
        status.textContent = `'${trimmed}' 와 일치하는 문서가 없습니다.`;
        return;
      }

      status.textContent = `'${trimmed}' 검색 결과 ${found.length}개`;
      render(found);
    };

    const syncUrl = (query) => {
      const url = new URL(window.location.href);
      if (query.trim()) url.searchParams.set("q", query.trim());
      else url.searchParams.delete("q");
      window.history.replaceState({}, "", url);
    };

    let timer;
    input.addEventListener("input", () => {
      window.clearTimeout(timer);
      timer = window.setTimeout(() => {
        syncUrl(input.value);
        search(input.value);
      }, 180);
    });

    form.addEventListener("submit", (event) => {
      event.preventDefault();
      syncUrl(input.value);
      search(input.value);
    });

    const initial = new URLSearchParams(window.location.search).get("q") || "";
    if (initial) {
      input.value = initial;
      search(initial);
    }
    input.focus();
  })();
</script>
