---
import type { GetStaticPaths } from "astro";
import ArticleLayout from "../../../layouts/ArticleLayout.astro";
import DocumentList from "../../../components/DocumentList.astro";
import { getCategories, getDocumentsInCategory, type WikiEntry } from "../../../lib/wiki";

export const getStaticPaths = (async () => {
  const categories = await getCategories();

  return Promise.all(
    categories.map(async (category) => ({
      params: { category: category.slug },
      props: {
        name: category.name,
        documents: await getDocumentsInCategory(category.name),
      },
    })),
  );
}) satisfies GetStaticPaths;

interface Props {
  name: string;
  documents: WikiEntry[];
}

const { name, documents } = Astro.props;

const updated = documents.reduce<Date>(
  (latest, document) => (document.data.updated > latest ? document.data.updated : latest),
  new Date(0),
);
---

<ArticleLayout
  data={{
    title: `분류: ${name}`,
    description: `${name} 분류에 속한 문서 목록`,
    lead: `${name} 분류에 속한 문서 ${documents.length}개다.`,
    updated,
    type: "document",
    indexed: false,
  }}
  headings={[]}
>
  <DocumentList documents={documents} hideCategory={name} />
</ArticleLayout>
