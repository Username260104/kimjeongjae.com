---
import ArticleLayout from "../layouts/ArticleLayout.astro";
import { allDocumentsHref, searchHref } from "../lib/wiki";
---

<ArticleLayout
  data={{
    title: "없는 문서를 발견하셨습니다",
    description: "요청한 주소에 해당하는 문서가 없습니다",
    lead: "이 주소에는 아직 문서가 없다. 주소를 잘못 입력했거나, 아직 작성되지 않은 문서일 수 있다.",
    updated: new Date(),
    type: "document",
    indexed: false,
  }}
  headings={[]}
>
  <ul>
    <li><a href={searchHref}>검색해서 찾아보기</a></li>
    <li><a href={allDocumentsHref}>모든 문서 목록 보기</a></li>
  </ul>
</ArticleLayout>
