---
import wordList from "../../output/emotion-words/감정_단어_목록.md?raw";

const words = wordList
  .split(/\r?\n/)
  .filter((line) => line.startsWith("- "))
  .map((line) => line.slice(2).trim())
  .filter(Boolean);
const canonical = Astro.site ? new URL("/", Astro.site) : undefined;
const siteTitle = "Kimjeongjae";
const description = "kimjeongjae.com";
const previewImage = new URL("/images/link-preview.png", Astro.site ?? Astro.url);
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" sizes="64x64" href="/favicon-python.png" />
    <script is:inline>
      (() => {
        const previewFont = new URLSearchParams(window.location.search).get("font");
        document.documentElement.dataset.font =
          previewFont === "myeongjo" || previewFont === "gothic"
            ? previewFont
            : Math.random() < 0.5 ? "myeongjo" : "gothic";
      })();
    </script>
    <script id="random-colors" is:inline>
      (() => {
        const storageKey = "kimjeongjae:last-hue";
        const excludedDistance = 30;
        let previousHue = null;

        try {
          const saved = sessionStorage.getItem(storageKey);
          if (saved !== null && /^\d{1,3}$/.test(saved) && Number(saved) < 360) {
            previousHue = Number(saved);
          }
        } catch {
          // Color selection still works when browser storage is unavailable.
        }

        // Uniformly sample the allowed arc, including across the 359°/0° boundary.
        const hue = previousHue === null
          ? Math.floor(Math.random() * 360)
          : (previousHue + excludedDistance + 1
            + Math.floor(Math.random() * (360 - excludedDistance * 2 - 1))) % 360;

        document.documentElement.style.setProperty("--text-hue", String(hue));
        try {
          sessionStorage.setItem(storageKey, String(hue));
        } catch {
          // A failed save must not prevent the page from rendering.
        }
      })();
    </script>
    <meta name="description" content={description} />
    <meta name="robots" content="nosnippet, noimageindex, max-image-preview:none" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteTitle} />
    <meta property="og:title" content={siteTitle} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={previewImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={siteTitle} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={siteTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={previewImage} />
    <meta name="twitter:image:alt" content={siteTitle} />
    <link
      rel="preload"
      href="/fonts/noto-serif-kr-title.ttf"
      as="font"
      type="font/ttf"
      crossorigin="anonymous"
    />
    {canonical && <link rel="canonical" href={canonical} />}
    <title>{siteTitle}</title>
  </head>
  <body>
    <main>
      <img src="/images/main.jpg" alt="메인 사진" width="360" height="480" />
      <h1 aria-label={words[0]}>
        <!-- The first word remains available when JavaScript is disabled. -->
        <svg
          viewBox="34 -853 1758 970"
          width="1758"
          height="970"
          preserveAspectRatio="xMidYMid meet"
          aria-hidden="true"
          focusable="false"
        >
          <text x="0" y="0" font-size="1000">{words[0]}</text>
        </svg>
      </h1>
    </main>
    <script id="emotion-words" type="application/json" is:inline set:html={JSON.stringify(words)} />
    <script is:inline>
      const words = JSON.parse(document.getElementById("emotion-words").textContent);
      const heading = document.querySelector("h1");
      const svg = heading.querySelector("svg");
      const text = svg.querySelector("text");
      const wordStorageKey = "kimjeongjae:last-word";
      let previousWord = null;
      try {
        previousWord = sessionStorage.getItem(wordStorageKey);
      } catch {
        // Keep displaying words when browser storage is unavailable.
      }
      const candidates = words.length > 1
        ? words.filter((candidate) => candidate !== previousWord)
        : words;
      const word = candidates[Math.floor(Math.random() * candidates.length)];
      const titleStyle = getComputedStyle(heading);
      const titleFont = `${titleStyle.fontWeight} 1000px ${titleStyle.fontFamily}`;
      // Choose once per visit, before the initial paint.
      svg.style.visibility = "hidden";
      heading.setAttribute("aria-label", word);
      text.textContent = word;
      try {
        sessionStorage.setItem(wordStorageKey, word);
      } catch {
        // A failed save must not prevent the word from rendering.
      }

      function fitWord() {
        const context = document.createElement("canvas").getContext("2d");
        let { x, y, width, height } = text.getBBox();

        if (context) {
          context.font = titleFont;
          const bounds = context.measureText(word);
          x = -bounds.actualBoundingBoxLeft;
          y = -bounds.actualBoundingBoxAscent;
          width = bounds.actualBoundingBoxLeft + bounds.actualBoundingBoxRight;
          height = bounds.actualBoundingBoxAscent + bounds.actualBoundingBoxDescent;
        }

        // Keep tight glyph bounds; SVG scales both axes together before stretching.
        svg.setAttribute("viewBox", `${x} ${y} ${width} ${height}`);
        svg.setAttribute("width", String(width));
        svg.setAttribute("height", String(height));
        svg.style.visibility = "visible";
      }

      document.fonts.load(titleFont, word).then(fitWord, fitWord);
    </script>
  </body>
</html>

<style>
  @font-face {
    font-family: "Title Myeongjo";
    src: url("/fonts/noto-serif-kr-title.ttf") format("truetype");
    font-style: normal;
    font-weight: 400;
    font-display: swap;
  }

  :global(:root) {
    --text-hue: 0;
  }

  :global(body) {
    margin: 0;
    background: hsl(calc(var(--text-hue) + 180) 100% 50%);
  }

  main {
    position: relative;
    isolation: isolate;
    display: grid;
    min-height: 100svh;
    place-items: center;
  }

  img {
    display: block;
    /* Scale the original 360×480 photo with the 1280×720 desktop composition. */
    width: min(360px, 28.125vw, 50svh);
    height: auto;
  }

  h1 {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: grid;
    place-items: center;
    margin: 0;
    color: hsl(var(--text-hue) 100% 50%);
    font-family: "Title Myeongjo", "Batang", "AppleMyungjo", serif;
    font-weight: 400;
    font-synthesis: none;
    line-height: 1;
    pointer-events: none;
  }

  :global(html[data-font="gothic"]) h1 {
    font-family: system-ui, -apple-system, BlinkMacSystemFont, "Apple SD Gothic Neo", "Malgun Gothic", "Noto Sans KR", sans-serif;
    font-weight: 200;
  }

  svg {
    --text-scale-y: 1.5;
    display: block;
    width: 100%;
    /* Fit proportionally into this frame, then stretch it to the viewport height. */
    height: calc(100svh / var(--text-scale-y));
    transform: scaleY(var(--text-scale-y));
    transform-origin: center;
    fill: currentColor;
  }
</style>
