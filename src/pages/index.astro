---
import { getEntry, render } from "astro:content";
import ArticleLayout from "../layouts/ArticleLayout.astro";
import PortalGrid from "../components/PortalGrid.astro";
import WikiNotice from "../components/WikiNotice.astro";

const entry = await getEntry("wiki", "main-page");

if (!entry) {
  throw new Error("Main page content was not found.");
}

const { Content, headings: renderedHeadings } = await render(entry);
const headings = entry.data.toc ?? renderedHeadings;
const { portal, notice } = entry.data;
---

<ArticleLayout entry={entry} headings={headings}>
  {portal && <PortalGrid panels={portal.panels} />}
  <Content />
  {notice && <WikiNotice {...notice} />}
</ArticleLayout>
