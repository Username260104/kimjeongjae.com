---
import type { CollectionEntry } from "astro:content";
import RecentChangeList from "./RecentChangeList.astro";
import { getRecentChanges } from "../lib/recent-changes";

type Panels = NonNullable<CollectionEntry<"wiki">["data"]["portal"]>;

interface Props {
  panel: Panels[number];
}

const { panel } = Astro.props;
const { variant, eyebrow, heading, slug } = panel.value;

// 최근 변경 패널만 Git 기록을 읽는다.
const changes =
  panel.discriminant === "changes" ? await getRecentChanges(panel.value.limit) : [];
---

<section class:list={["portal-panel", `portal-panel--${variant}`]}>
  <header class="portal-panel__header">
    <p>{eyebrow}</p>
    <h2 id={slug}>{heading}</h2>
  </header>

  <div class="portal-panel__body">
    {panel.discriminant === "prose" && (
      <>
        {panel.value.paragraphs.map((paragraph) => (
          <p>{paragraph.term && <strong>{paragraph.term}</strong>}{paragraph.text}</p>
        ))}
        {panel.value.more?.label && (
          <p class="portal-panel__more"><a href={panel.value.more.href}>{panel.value.more.label}</a></p>
        )}
      </>
    )}

    {panel.discriminant === "index" && (
      <dl class="portal-index">
        {panel.value.entries.map((entry) => (
          <div>
            <dt>{entry.href ? <a href={entry.href}>{entry.term}</a> : entry.term}</dt>
            <dd>{entry.description}</dd>
          </div>
        ))}
      </dl>
    )}

    {panel.discriminant === "list" && (
      <ul>
        {panel.value.items.map((item) => <li>{item}</li>)}
      </ul>
    )}

    {panel.discriminant === "changes" && <RecentChangeList changes={changes} />}
  </div>
</section>
