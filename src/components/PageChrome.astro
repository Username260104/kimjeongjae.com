---
interface Props {
  title: string;
  description: string;
  updated: Date;
}

const { title, description, updated } = Astro.props;
const formattedDate = new Intl.DateTimeFormat("ko-KR", {
  year: "numeric",
  month: "long",
  day: "numeric",
}).format(updated);
---

<header class="article-header">
  <div class="article-heading">
    <h1>{title}</h1>
    <p>{description}</p>
  </div>

  <div class="page-tabs">
    <nav class="page-tabs__group" aria-label="문서 종류">
      <span class="page-tab page-tab--current" aria-current="page">문서</span>
      <span class="page-tab page-tab--disabled">토론</span>
    </nav>
    <nav class="page-tabs__group page-tabs__tools" aria-label="문서 도구">
      <span class="page-tab page-tab--current" aria-current="page">읽기</span>
      <span class="page-tab page-tab--disabled page-tab--optional">원본 보기</span>
      <span class="page-tab page-tab--disabled page-tab--optional">역사 보기</span>
    </nav>
  </div>

  <p class="article-updated">마지막 수정: {formattedDate}</p>
</header>
