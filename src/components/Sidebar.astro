---
import {
  allDocumentsHref,
  getCategories,
  recentChangesHref,
} from "../lib/wiki";

interface Props {
  currentPath: string;
  compact?: boolean;
}

const { currentPath, compact = false } = Astro.props;
const base = import.meta.env.BASE_URL;

// 탐색 항목은 실제로 존재하는 페이지만 둔다.
const links = [
  { label: "대문", href: base },
  { label: "모든 문서", href: allDocumentsHref },
  { label: "최근 변경", href: recentChangesHref },
];

const categories = await getCategories();

const normalize = (path: string) => (path.endsWith("/") ? path : `${path}/`);
const isCurrent = (href: string) => normalize(currentPath) === normalize(href);
---

<nav
  class:list={["sidebar-nav", { "sidebar-nav--compact": compact }]}
  aria-label={compact ? "모바일 둘러보기" : "둘러보기"}
>
  <div class="sidebar-section">
    <h2>둘러보기</h2>
    <ul>
      {links.map((link) => (
        <li>
          <a href={link.href} aria-current={isCurrent(link.href) ? "page" : undefined}>
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </div>

  {categories.length > 0 && (
    <div class="sidebar-section sidebar-section--secondary">
      <h2>분류</h2>
      <ul>
        {categories.map((category) => (
          <li>
            <a href={category.href} aria-current={isCurrent(category.href) ? "page" : undefined}>
              {category.name}
            </a>
          </li>
        ))}
      </ul>
    </div>
  )}
</nav>
