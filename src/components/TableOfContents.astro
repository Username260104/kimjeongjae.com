---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
  compact?: boolean;
}

const { headings, compact = false } = Astro.props;
---

{headings.length > 0 && (
  <nav class:list={["table-of-contents", { "table-of-contents--compact": compact }]} aria-label="목차">
    <div class="table-of-contents__heading">
      <strong>목차</strong>
      {!compact && <span>이 문서에서</span>}
    </div>
    <ol>
      {headings.map((heading) => (
        <li class:list={[{ "toc-depth-3": heading.depth === 3 }]}>
          <a href={`#${heading.slug}`}>{heading.text}</a>
        </li>
      ))}
    </ol>
  </nav>
)}
