---
interface Field {
  label: string;
  value: string;
  href?: string;
}

interface Props {
  heading: string;
  caption?: string;
  fields: Field[];
}

const { heading, caption, fields } = Astro.props;
---

<aside class="infobox" aria-label={`${heading} 정보`}>
  <div class="infobox__title">{heading}</div>
  {caption && <p class="infobox__caption">{caption}</p>}
  <dl>
    {fields.map((field) => (
      <div>
        <dt>{field.label}</dt>
        <dd>{field.href ? <a href={field.href}>{field.value}</a> : field.value}</dd>
      </div>
    ))}
  </dl>
</aside>
