---
import type { CollectionEntry } from "astro:content";
import PortalPanel from "./PortalPanel.astro";

type Panels = NonNullable<CollectionEntry<"wiki">["data"]["portal"]>;

interface Props {
  panels: Panels;
}

const { panels } = Astro.props;
---

<div class="portal-grid">
  {panels.map((panel) => <PortalPanel panel={panel} />)}
</div>
