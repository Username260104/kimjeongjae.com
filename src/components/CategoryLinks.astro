---
import { categoryHref } from "../lib/wiki";

interface Props {
  categories: string[];
}

const { categories } = Astro.props;
---

{categories.length > 0 && (
  <nav class="category-links" aria-label="문서 분류">
    <strong>분류:</strong>
    <ul>
      {categories.map((category) => (
        <li><a href={categoryHref(category)}>{category}</a></li>
      ))}
    </ul>
  </nav>
)}
