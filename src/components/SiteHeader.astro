---
import { Menu, Search, SlidersHorizontal } from "@lucide/astro";
import Sidebar from "./Sidebar.astro";
import { searchHref } from "../lib/wiki";

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<header class="site-header">
  <div class="site-header__inner">
    <details class="mobile-menu">
      <summary class="icon-button" aria-label="둘러보기 메뉴">
        <Menu aria-hidden="true" size={21} stroke-width={1.8} />
      </summary>
      <div class="mobile-menu__panel">
        <Sidebar currentPath={currentPath} compact />
      </div>
    </details>

    <a class="wordmark" href={base} aria-label="Kimjeongjae Wiki 대문">
      <span class="wordmark__text">
        <strong>Kimjeongjae</strong>
        <small>Wiki</small>
      </span>
    </a>

    <form class="site-search" role="search" aria-label="Wiki 검색" action={searchHref} method="get">
      <Search class="site-search__icon" aria-hidden="true" size={18} stroke-width={1.8} />
      <input type="search" name="q" placeholder="Wiki 검색" aria-label="Wiki 검색" />
      <button type="submit">검색</button>
    </form>

    <a class="mobile-search icon-button" href={searchHref} aria-label="Wiki 검색">
      <Search aria-hidden="true" size={20} stroke-width={1.8} />
    </a>

    <div class="site-header__utility" aria-label="화면 도구">
      <SlidersHorizontal aria-hidden="true" size={17} stroke-width={1.7} />
      <span>개인 포트폴리오</span>
    </div>
  </div>
</header>
